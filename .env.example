# Only stage 04 (the agent) needs an LLM. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Any OpenRouter model that supports tools. Cheap and reliable default:
LLM_MODEL=google/gemini-3.8-flash
# Free alternatives (less reliable at tool calling):
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Point at a different OpenAI-compatible API (e.g. local Ollama):
# LLM_BASE_URL=http://localhost:11434/v1

# Stage 05: require a bearer token on the HTTP server
# MCP_LAB_TOKEN=change-me
